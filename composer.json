{
  "name": "speicher210/cloudinary-bundle",
  "description": "Bundle for Cloudinary PHP API library",
  "license": "MIT",
  "type": "symfony-bundle",
  "keywords": [
    "cloudinary",
    "symfony",
    "bundle"
  ],
  "authors": [
    {
      "name": "Dragos Protung",
      "email": "dragos@protung.de",
      "role": "Developer"
    }
  ],
  "homepage": "https://github.com/protung/cloudinary-bundle",
  "require": {
    "php": "~8.3.0 || ~8.4.0",
    "azjezz/psl": "^3.0.0",
    "cloudinary/cloudinary_php": "^3.1.1",
    "symfony/console": "^6.4 || ^7.2",
    "symfony/finder": "^6.4 || ^7.2",
    "symfony/framework-bundle": "^6.4 || ^7.2",
    "symfony/yaml": "^6.4 || ^7.2"
  },
  "require-dev": {
    "doctrine/coding-standard": "^13.0",
    "ergebnis/composer-normalize": "^2.47.0",
    "php-standard-library/phpstan-extension": "^2.0.0",
    "php-standard-library/psalm-plugin": "^2.3",
    "phpstan/phpstan": "^2.1.17",
    "phpstan/phpstan-deprecation-rules": "^2.0.3",
    "phpstan/phpstan-phpunit": "^2.0.6",
    "phpstan/phpstan-strict-rules": "^2.0.4",
    "phpstan/phpstan-symfony": "^2.0.6",
    "phpunit/phpunit": "^12.2.6",
    "psalm/plugin-phpunit": "^0.19.5",
    "roave/security-advisories": "dev-latest",
    "twig/twig": "^3.21",
    "vimeo/psalm": "^6.12.1"
  },
  "suggest": {
    "twig/twig": "Allow to use the cloudinary_url function/filter"
  },
  "minimum-stability": "stable",
  "autoload": {
    "psr-4": {
      "Speicher210\\CloudinaryBundle\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Speicher210\\CloudinaryBundle\\Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "ergebnis/composer-normalize": true
    },
    "sort-packages": true
  }
}
